# Go through each analysis folder (analysis folder)
for i, analysisFolder in enumerate(analysisFolders):
    
    Ratio_Pauses_10_20_ALL = []

    # Find all the npz files saved for each group and fish with all the information
    npzFiles = glob.glob(analysisFolder+'/*.npz')
    
    # Calculate how many files
    numFiles = np.size(npzFiles, 0)

    # Allocate space for summary data
    Pauses_NS_ALL = np.zeros((numFiles, 10))      
    Pauses_S_ALL = np.zeros((numFiles, 10)) 
    Bouts_NS_ALL = np.zeros((numFiles, 10)) 
    Bouts_S_ALL = np.zeros((numFiles, 10))
    Pauses_NS_ALL_visible = np.zeros((numFiles, 10))      
    Pauses_S_ALL_visible = np.zeros((numFiles, 10)) 
    Bouts_NS_ALL_visible = np.zeros((numFiles, 10)) 
    Bouts_S_ALL_visible = np.zeros((numFiles, 10))
    
    # Go through all the files contained in the analysis folder
    for f, filename in enumerate(npzFiles):
    
        # Load each npz file
        dataobject = np.load(filename)
        
        # Extract from the npz file
        Pauses_NS = dataobject['Pauses_NS']   
        Pauses_S = dataobject['Pauses_S']
        Bouts_NS = dataobject['Bouts_NS']
        Bouts_S = dataobject['Bouts_S']
        #print(f"Original Bouts_S shape: {Bouts_S.shape}")

         # Filter Arrays where column 9 equals 1 (visible frames)
        Bouts_NS_visible = Bouts_NS[Bouts_NS[:, 9] == 1]
        Bouts_S_visible = Bouts_S[Bouts_S[:, 9] == 1]
        Pauses_NS_visible = Pauses_NS[Pauses_NS[:, 9] == 1]
        Pauses_S_visible = Pauses_S[Pauses_S[:, 9] == 1]
        #print(f"Filtered Bouts_S shape: {Bouts_NS_visible.shape}")

        # Compute column-wise mean for the visible array. We want avg each fish
        if Bouts_NS_visible.size > 0:  # Check if the filtered array is not empty
            Bouts_NS_visible_means = np.mean(Bouts_NS_visible, axis=0)
            Bouts_S_visible_means = np.mean(Bouts_S_visible, axis=0)
            Pauses_NS_visible_means = np.mean(Pauses_NS_visible, axis=0)
            Pauses_S_visible_means = np.mean(Pauses_S_visible, axis=0)   #avg of columns


            #print("Column-wise means of filtered Bouts_NS:")
            Bouts_NS_ALL_visible = np.vstack([Bouts_NS_ALL_visible, Bouts_NS_visible_means])
            Bouts_S_ALL_visible = np.vstack([Bouts_S_ALL_visible, Bouts_S_visible_means])
            Pauses_NS_ALL_visible = np.vstack([Pauses_NS_ALL_visible, Pauses_NS_visible_means])
            Pauses_S_ALL_visible= np.vstack([Pauses_S_ALL_visible, Pauses_S_visible_means])
            #print(Bouts_NS_visible_means)
        else:
            print("No rows where column 9 equals 1.")
            #print(filename)

    Pauses_NS_summary_visible.append(Pauses_NS_ALL_visible)     
    Pauses_S_summary_visible.append(Pauses_S_ALL_visible) 
    Bouts_NS_summary_visible.append(Bouts_NS_ALL_visible) 
    Bouts_S_summary_visible.append(Bouts_S_ALL_visible) 




