#FIGURE 1 - Sum of Bouts duration in the visible area only durin SC

series_list_bouts_S_visible = []

for i, name in enumerate(conditionNames):
    # Extract each condition Bouts_S_ALL (:,9) lenght of all bouts of all fish
    condition_bouts_S_visible = Bouts_S_summary_visible[i] # 
    Bouts_S_duration = condition_bouts_S_visible[:,8]*10
    Bouts_S_duration = Bouts_S_duration[Bouts_S_duration > 0]  # Keep only positive durations

    # Create a pandas Series with the extracted and filtered data
    s_bouts_S_visible = pd.Series(Bouts_S_duration, name=f"S: {name}")

    
    # Append the Series to the list
    series_list_bouts_S_visible.append(s_bouts_S_visible)
    

# Combine all Series into a DataFrame
df_bouts_S_visible = pd.concat(series_list_bouts_S_visible, axis=1)


# Melt the DataFrame for compatibility with Seaborn
df_long_bouts_S_visible = df_bouts_S_visible.melt(var_name="Condition", value_name="Duration")

# Plot a boxplot for each condition
plt.figure(figsize=(12, 6))
sns.boxplot(x="Condition", y="Duration", data=df_long_bouts_S_visible, hue="Condition", palette="pastel", linewidth=1.5, showfliers=False,dodge=False  )
plt.title("Bouts durations with Social Cue")
plt.ylabel('Duration (seconds)', fontsize=12)
plt.xticks(rotation=45)
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.ylabel('ms')
plt.tight_layout()


# Overlay individual data points
sns.stripplot(
    x="Condition",  # Align dots with conditions
    y="Duration",      # Align dots with values
    data=df_long_bouts_S_visible,   # Use the melted DataFrame
    color="#404040",  # Set dot color
    #color=box_colours_rgba2,  # Set dot color
    alpha=0.7,      # Adjust dot transparency
    jitter=True,    # Add jitter to avoid overlap of dots
    size=4          # Adjust dot size
)


# Add horizontal lines
plt.axhline(y=200, color='red', linestyle='--', linewidth=1.5, label="y = 100")
plt.axhline(y=50, color='blue', linestyle='--', linewidth=1.5, label="y = 20")
plt.tight_layout()

analysisFolder_figures = base_path + r'/Final_Figures/Bouts_duration'
filename = analysisFolder_figures + '/Bouts_All_Durations_S_visible.png'
plt.savefig(filename, dpi=300)
plt.show(block=False)



